# Ilova sozlamalari
PROJECT_NAME=QueueLess API
API_V1_PREFIX=/api/v1

# Database
# Lokal test uchun SQLite (hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite:///./queueless.db
# Production uchun PostgreSQL misoli:
# DATABASE_URL=postgresql://user:password@localhost:5432/queueless

# JWT
SECRET_KEY=CHANGE_ME_super_secret_key_please
# TO'G'RI (7 kun daqiqalarda = 10080):
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Push notification (Firebase Cloud Messaging) - keyinchalik ulanadi
FCM_SERVER_KEY=

# CORS - frontend manzili
BACKEND_CORS_ORIGINS=["*"]
