# QueueLess API — Environment Variables Example
# Bu faylni .env deb nusxalang va qiymatlarni o'zgartiring:
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env

# ─────────────────────────────────────────────
# Ilova sozlamalari
# ─────────────────────────────────────────────
PROJECT_NAME=QueueLess API
API_V1_PREFIX=/api/v1

# ─────────────────────────────────────────────
# Ma'lumotlar bazasi
# ─────────────────────────────────────────────
# Lokal test uchun (hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite:///./queueless.db

# Production uchun PostgreSQL (tavsiya etiladi):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/queueless

# ─────────────────────────────────────────────
# JWT Xavfsizlik — MUHIM!
# ─────────────────────────────────────────────
# Bu qiymatni ALBATTA o'zgartiring! Quyidagi buyruq bilan yangi key oling:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_THIS_WITH_RANDOM_64_CHAR_HEX_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ─────────────────────────────────────────────
# Push Notifications (Expo)
# ─────────────────────────────────────────────
# Expo Push Notifications uchun access token (ixtiyoriy).
# https://expo.dev/accounts/[username]/settings/access-tokens sahifasidan oling.
EXPO_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# CORS sozlamalari
# ─────────────────────────────────────────────
# Production uchun: faqat o'z domeningizni ko'rsating!
# BACKEND_CORS_ORIGINS=["https://yourapp.com","https://api.yourapp.com"]
# Lokal test uchun (barchaga ruxsat):
BACKEND_CORS_ORIGINS=["*"]
